{
	"name": "n8n-nodes-printfriendly",
	"version": "0.1.1",
	"description": "n8n community node for the PrintFriendly API: turn web pages, HTML and Markdown into PDF, Word, Markdown, JSON, HTML or plain text.",
	"license": "MIT",
	"homepage": "https://www.printfriendly.com/api/instructions/v2",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"printfriendly",
		"pdf",
		"docx",
		"markdown",
		"html-to-pdf",
		"web-to-pdf",
		"web-to-markdown"
	],
	"author": {
		"name": "PrintFriendly",
		"email": "support@printfriendly.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/printfriendly/n8n-nodes-printfriendly.git"
	},
	"bugs": {
		"url": "https://github.com/printfriendly/n8n-nodes-printfriendly/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "n8n-node build && node --test test/*.test.mjs",
		"prepublishOnly": "npm run lint && npm run build"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo",
		"README.md",
		"LICENSE.md"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/PrintFriendlyApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/PrintFriendly/PrintFriendly.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
